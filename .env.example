# ============================================================
#  APIKuoshi — .env.example
#  Copy to .env and adjust. EVERYTHING below is optional —
#  the API boots with zero configuration and zero paid services.
# ============================================================

# --- server -------------------------------------------------
PORT=6969
NODE_ENV=development

# CORS origins, comma-separated (* = allow all)
ALLOWED_ORIGINS=*

# --- data layer ---------------------------------------------
# Priority order of the internal data lanes (advanced — you normally
# never touch this). Valid ids: kaze,ishi
SOURCE_PRIORITY=kaze,ishi

# Requests each IP may make per window (0 disables rate limiting)
RATE_LIMIT_MAX=240
RATE_LIMIT_WINDOW_MS=60000

# Internal fetch timeout per request phase (ms)
SOURCE_TIMEOUT_MS=20000

# Response cache TTL (seconds, 0 disables)
CACHE_SECONDS=180

# Title-match strictness for romaji/English dedup (50-99; 78 = balanced)
DEDUP_THRESHOLD=78

# ============================================================
#  OPTIONAL — paid / self-hosted bypass services.
#  APIKuoshi does NOT need these. If present, the internal
#  fetchers that support them use them automatically.
# ============================================================
# SCRAPER_API_KEY=
# FLARESOLVERR_URL=http://localhost:8191

# ============================================================
#  OPTIONAL — catalogue mirror / playback tuning
# ============================================================
# MIRROR_DOMAINS=https://anikototv.to,https://anikoto.cz,https://anikoto.me,https://anikoto.net,https://anikototv.se
# STREAM_PROXY_DOMAINS=megaplay.buzz,vidtube.site,vid-tube.site,vidplay.site,anipixcdn.co,norami.top,kryntal.top,akirax.buzz
# STREAM_PROXY_REFERER=https://megaplay.buzz/

# ============================================================
#  OPTIONAL — art enrichment providers (v2.3.0)
#  Both are OPTIONAL: the API works fully without either.
# ============================================================
# TMDB_API_KEY=your_tmdb_v3_api_key
#   TMDB (themoviedb.org) fills backdrop/logo art and season-aware
#   posters + episode stills. Free key at themoviedb.org -> settings
#   -> API. Without it, TMDB enrichment is skipped entirely and
#   silently — Kitsu (keyless, always on) still fills poster/cover.
# ART_ENRICHMENT=1
#   Set to 0 to disable provider enrichment globally (upstream art
#   only). Per-request escape hatch: &art=0 on any browse/catalog
#   endpoint.
# ENRICH_CONCURRENCY=8
#   Bounded parallelism for list enrichment (1-16, default 8).
